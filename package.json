{
  "name": "hampton-jersey",
  "private": true,
  "scripts": {
    "build": "node scripts/check-release.mjs && vite build --config admin/vite.config.mjs",
    "build:watch": "vite build --config admin/vite.config.mjs --watch",
    "dev": "wrangler pages dev --port 8788",
    "check:release": "node scripts/check-release.mjs --strict",
    "check:avanzar": "node scripts/check-avanzar.mjs",
    "team": "node scripts/avanzar-team.mjs",
    "team:catalog": "node scripts/render-roadmap.mjs",
    "team:check": "node scripts/render-roadmap.mjs --check",
    "test:team:dom": "node tests/equipo.e2e.cjs --dom",
    "test:team:runtime": "node --test coordination/test/*.test.mjs",
    "team:build": "node scripts/render-roadmap.mjs --assets && wrangler deploy --config coordination/wrangler.toml --dry-run --outdir coordination/build",
    "test": "node --test tests/*.test.js tests/server/*.test.mjs && python3 -m unittest tests/test_import.py tests/test_directory_manifest.py",
    "test:e2e": "node tests/run-e2e.cjs",
    "test:e2e:isolated": "bash scripts/test-e2e-isolated.sh",
    "dev:e2e": "node tests/serve-e2e.cjs",
    "team:public:build": "node scripts/build-public-team.mjs --dry-run",
    "plan:packages": "node scripts/plan-packages.mjs",
    "check:packages": "node scripts/plan-packages.mjs --check",
    "test:production:readonly": "E2E_PRODUCTION_READONLY=1 bash scripts/test-e2e-isolated.sh"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "jose": "^6.2.12",
    "postal-mime": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "vite": "^8.3.3",
    "wrangler": "^4.148.0"
  }
}
