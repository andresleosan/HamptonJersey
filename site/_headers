/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
/admin/*
  X-Frame-Options: DENY
  X-Robots-Tag: noindex
# AGE-12: a client's private selection (its data comes from /api/presentation, never cached either).
/presentation
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Frame-Options: DENY
  X-Robots-Tag: noindex
# ADM-12: a tenant's private link to report a repair (its data comes from /api/repair-report, never cached either).
/repair-report
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Frame-Options: DENY
  X-Robots-Tag: noindex
# ADM-18: an applicant's private link to a rental application (served only with ADM18_APPLICATION_READY).
/rental-application
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Frame-Options: DENY
  X-Robots-Tag: noindex
