{
  "name": "hampton-app-qa",
  "services": {
    "runner": {
      "platform": "linux/amd64",
      "pull_policy": "never",
      "user": "1000:1000",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true",
        "seccomp=E:\\Proyectos\\HamptonJersey\\docs\\qa\\full-app\\runner\\seccomp_profile.json"
      ],
      "init": true,
      "restart": "no",
      "logging": {
        "driver": "none"
      },
      "stdin_open": false,
      "tty": false,
      "environment": {
        "HOME": "/tmp/home",
        "HTTP_PROXY": "",
        "HTTPS_PROXY": "",
        "ALL_PROXY": "",
        "NO_PROXY": "",
        "http_proxy": "",
        "https_proxy": "",
        "all_proxy": "",
        "no_proxy": ""
      },
      "tmpfs": [
        "/tmp:rw,nosuid,nodev,noexec,size=256m,mode=1777",
        "/run/qa:rw,nosuid,nodev,noexec,size=32m,mode=0700,uid=1000,gid=1000"
      ],
      "image": "mcr.microsoft.com/playwright@sha256:bc4fbb329a25287ed23e9216c97063646abdd1bf2da669a9895fa3e2078b2302",
      "container_name": "hampton-app-qa-runner",
      "working_dir": "/work",
      "entrypoint": [
        "node",
        "/work/idle.mjs"
      ],
      "command": [],
      "volumes": [
        {
          "type": "bind",
          "source": "E:/Proyectos/HamptonJersey/test-results/qa-agent-runtime/runner-package",
          "target": "/work",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        },
        {
          "type": "bind",
          "source": "E:/Proyectos/HamptonJersey/test-results/qa-agent-runtime/results",
          "target": "/results",
          "read_only": false,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "networks": {
        "internal": {
          "ipv4_address": "172.30.230.3"
        }
      },
      "dns": [
        "127.0.0.1"
      ],
      "mem_limit": "2g",
      "memswap_limit": "2g",
      "cpus": 2,
      "pids_limit": 256,
      "ipc": "private",
      "shm_size": "512m",
      "depends_on": {
        "egress": {
          "condition": "service_healthy"
        }
      }
    },
    "egress": {
      "platform": "linux/amd64",
      "pull_policy": "never",
      "user": "1000:1000",
      "read_only": true,
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "init": true,
      "restart": "no",
      "logging": {
        "driver": "none"
      },
      "stdin_open": false,
      "tty": false,
      "environment": {
        "HOME": "/tmp/home",
        "PYTHONPATH": "/policy",
        "PYTHONDONTWRITEBYTECODE": "1",
        "HTTP_PROXY": "",
        "HTTPS_PROXY": "",
        "ALL_PROXY": "",
        "NO_PROXY": "",
        "http_proxy": "",
        "https_proxy": "",
        "all_proxy": "",
        "no_proxy": ""
      },
      "tmpfs": [
        "/tmp:rw,nosuid,nodev,noexec,size=256m,mode=1777",
        "/run/qa:rw,nosuid,nodev,noexec,size=32m,mode=0700,uid=1000,gid=1000",
        "/home/mitmproxy/.mitmproxy:rw,nosuid,nodev,noexec,size=4m,mode=0700,uid=1000,gid=1000"
      ],
      "image": "mitmproxy/mitmproxy@sha256:e2f810b6e618258dd4980716da143c4a8de0edcb3243264baea398e2185bbbfb",
      "container_name": "hampton-app-qa-egress",
      "working_dir": "/policy",
      "entrypoint": [
        "/bin/sh",
        "-c"
      ],
      "command": [
        "umask 077; exec mitmdump --quiet --mode regular --listen-host 172.30.230.2 --listen-port 3128 --set confdir=/run/qa/mitmproxy --set connection_strategy=lazy --set upstream_cert=false --set ssl_insecure=false --set rawtcp=false --set http2=false --set flow_detail=0 --set termlog_verbosity=error -s /policy/egress_addon.py >/dev/null 2>&1"
      ],
      "volumes": [
        {
          "type": "bind",
          "source": "E:/Proyectos/HamptonJersey/test-results/qa-agent-runtime/egress-package",
          "target": "/policy",
          "read_only": true,
          "bind": {
            "create_host_path": false
          }
        }
      ],
      "networks": {
        "internal": {
          "ipv4_address": "172.30.230.2"
        },
        "egress": {
          "ipv4_address": "172.30.231.2",
          "gw_priority": 1
        }
      },
      "mem_limit": "256m",
      "memswap_limit": "256m",
      "cpus": 0.5,
      "pids_limit": 64,
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "from pathlib import Path; assert Path('/run/qa/policy-ready').read_text()=='hampton-app-qa-egress-v1'"
        ],
        "interval": "3s",
        "timeout": "2s",
        "retries": 10,
        "start_period": "5s"
      }
    }
  },
  "networks": {
    "internal": {
      "name": "hampton-app-qa-internal",
      "driver": "bridge",
      "internal": true,
      "enable_ipv6": false,
      "driver_opts": {
        "com.docker.network.bridge.gateway_mode_ipv4": "isolated"
      },
      "ipam": {
        "config": [
          {
            "subnet": "172.30.230.0/28"
          }
        ]
      }
    },
    "egress": {
      "name": "hampton-app-qa-outbound",
      "driver": "bridge",
      "enable_ipv6": false,
      "ipam": {
        "config": [
          {
            "subnet": "172.30.231.0/28"
          }
        ]
      }
    }
  }
}
